#include <iostream>
#include <vector>
#include <climits>
using namespace std;

int main() {
    int n;

    cout << "Enter number of matrices: ";
    cin >> n;

    // p contains dimensions of matrices
    // Matrix A1 = p[0] x p[1]
    // Matrix A2 = p[1] x p[2], etc.
    vector<int> p(n + 1);

    cout << "Enter dimensions: ";
    for (int i = 0; i <= n; i++) {
        cin >> p[i];
    }

    // dp[i][j] = minimum cost to multiply matrices i through j
    vector<vector<int>> dp(n + 1, vector<int>(n + 1, 0));

    // length is the chain length
    for (int length = 2; length <= n; length++) {

        for (int i = 1; i <= n - length + 1; i++) {

            int j = i + length - 1;
            dp[i][j] = INT_MAX;

            // Try every possible split
            for (int k = i; k < j; k++) {

                int cost = dp[i][k]
                         + dp[k + 1][j]
                         + p[i - 1] * p[k] * p[j];

                dp[i][j] = min(dp[i][j], cost);
            }
        }
    }

    cout << "Minimum number of scalar multiplications: "
         << dp[1][n] << endl;

    return 0;
}
