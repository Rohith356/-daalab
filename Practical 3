using namespace std;
using namespace chrono;

//------------- MAX HEAPIFY -------------//
void adjustMaxHeap(vector<int> &v, int size, int parent)
{
    while (true)
    {
        int left = parent * 2 + 1;
        int right = parent * 2 + 2;
        int big = parent;

        if (left < size && v[left] > v[big])
            big = left;

        if (right < size && v[right] > v[big])
            big = right;

        if (big == parent)
            break;

        swap(v[parent], v[big]);
        parent = big;
    }
}

void sortUsingMaxHeap(vector<int> &v)
{
    int n = v.size();

    for (int i = (n - 2) / 2; i >= 0; --i)
        adjustMaxHeap(v, n, i);

    while (n > 1)
    {
        swap(v[0], v[n - 1]);
        n--;
        adjustMaxHeap(v, n, 0);
    }
}

//------------- MIN HEAPIFY -------------//
void adjustMinHeap(vector<int> &v, int size, int parent)
{
    while (true)
    {
        int left = parent * 2 + 1;
        int right = parent * 2 + 2;
        int small = parent;

        if (left < size && v[left] < v[small])
            small = left;

        if (right < size && v[right] < v[small])
            small = right;

        if (small == parent)
            break;

        swap(v[parent], v[small]);
        parent = small;
    }
}

void sortUsingMinHeap(vector<int> &v)
{
    int n = v.size();

    for (int i = (n - 2) / 2; i >= 0; --i)
        adjustMinHeap(v, n, i);

    while (n > 1)
    {
        swap(v[0], v[n - 1]);
        n--;
        adjustMinHeap(v, n, 0);
    }

    reverse(v.begin(), v.end());
}

